{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "fix/*": false,
      "feat/*": false,
      "chore/*": false,
      "docs/*": false,
      "test/*": false,

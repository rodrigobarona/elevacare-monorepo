{
  "name": "@eleva/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "TURBO_TASKS_FORCE_WATCH_MODE=nonrecursive next dev --turbopack --port 3000",
    "prebuild": "fumadocs-mdx",
    "predev": "fumadocs-mdx",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eleva/api-client": "workspace:*",
    "@eleva/auth": "workspace:^",
    "@eleva/billing": "workspace:*",
    "@eleva/calendar": "workspace:*",
    "@eleva/compliance": "workspace:*",
    "@eleva/config": "workspace:^",
    "@eleva/content": "workspace:*",
    "@eleva/observability": "workspace:^",
    "@eleva/ui": "workspace:*",
    "@eleva/icons": "workspace:*",
    "botid": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@eleva/media": "workspace:*"
  },
  "devDependencies": {
    "@eleva/eslint-config": "workspace:*",
    "@eleva/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:",
    "vitest": "catalog:"
  }
}

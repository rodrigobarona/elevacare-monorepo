{
  "extends": "@eleva/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@eleva/ui/*": ["../../packages/ui/src/*"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "src/**/*",
    ".next/types/**/*.ts",
    ".source/**/*.ts",
    "messages/**/*.json"
  ],
  "exclude": ["node_modules", "source.config.ts"]
}

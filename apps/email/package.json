{
  "name": "@eleva/email-preview",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "email dev --port 3009 --dir ../../packages/email/src/templates",
    "build": "email build --dir ../../packages/email/src/templates",
    "export": "email export --dir ../../packages/email/src/templates",
    "lint": "eslint . ../../packages/email/src/templates ../../packages/email/src/components",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"../../packages/email/src/{templates,components}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eleva/email": "workspace:*",
    "@react-email/ui": "6.1.4",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "6.1.4"
  },
  "devDependencies": {
    "@eleva/eslint-config": "workspace:*",
    "@eleva/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}

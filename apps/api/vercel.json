{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/cron/keep-alive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/booking-probes",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/workflows/tick/minutely",
      "schedule": "* * * * *"
    },
    {
      "path": "/workflows/tick/10min",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/workflows/tick/hourly",
      "schedule": "5 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/*": false,
      "feat/*": false,
      "chore/*": false,
      "docs/*": false,
      "test/*": false,
      "refactor/*": false,
      "perf/*": false,
      "ci/*": false,
      "phase-*": false,
      "renovate/*": false
    }
  }
}

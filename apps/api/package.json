{
  "name": "@eleva/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "setup:qstash": "tsx --env-file=../../.env.local scripts/setup-qstash-schedule.ts"
  },
  "dependencies": {
    "@eleva/accounting": "workspace:^",
    "@eleva/auth": "workspace:*",
    "@eleva/billing": "workspace:*",
    "@eleva/config": "workspace:*",
    "@eleva/db": "workspace:*",
    "@eleva/encryption": "workspace:^",
    "@eleva/observability": "workspace:*",
    "@eleva/storage": "workspace:*",
    "@eleva/ui": "workspace:*",
    "@eleva/workflows": "workspace:*",
    "@upstash/qstash": "^2.11.0",
    "@upstash/redis": "^1.38.0",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@eleva/eslint-config": "workspace:*",
    "@eleva/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

  "typography": {
    "display": {
      "family": "Fraunces (variable opsz 9–144, wght 300–700, roman + italic)",
      "use": "hero, page titles, section headings, editorial italics accent"
    },
    "sans": {
      "family": "DM Sans (variable wght 400–700)",
      "use": "UI, body, forms, tables"
    },
    "mono": {
      "family": "IBM Plex Mono 400/500",
      "use": "eyebrows, codes, references, numeric meta"
    },
    "steps": {
      "display": "clamp(2.75rem, 1.9rem + 3.6vw, 5rem) / 1.04 / -0.025em",
      "headline": "clamp(2rem, 1.55rem + 1.9vw, 3.25rem) / 1.1 / -0.02em",
      "title": "clamp(1.5rem, 1.3rem + 0.8vw, 2rem) / 1.2 / -0.012em",
      "lead": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem) / 1.6",
      "body": "1rem / 1.6 (product), 1.0625rem marketing prose",
      "eyebrow": "0.75rem mono uppercase / 0.14em"
    }
  },
  "radius": {
    "base": "0.75rem",
    "sm": "0.45rem",
    "md": "0.6rem",
    "lg": "0.75rem",
    "xl": "1.05rem",
    "2xl": "1.35rem",
    "3xl": "1.65rem",
    "4xl": "1.95rem",
    "pill": "9999px — buttons on marketing, chips, avatars"
  },
  "shadow": {
    "tint": "oklch(0.32 0.03 60)",
    "1": "hairline lift (inputs, chips)",
    "2": "cards on hover, popovers",
    "3": "dialogs, hero media"
  },
  "motion": {
    "ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.4, 0.64, 1)",
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "slower": "560ms",
    "reducedMotion": "all animations collapse to 0.01ms under prefers-reduced-motion"
  }
}

{
  "$schema": "eleva-brand-v3",
  "status": "proposed — founder review on preview before production deploy (decision-log 2026-10-19)",
  "note": "v3 keeps every v2 scale (teal, coral, neutral, success, warning, danger, info) unchanged — see ../v2/tokens.json. v3 adds the sand scale, the semantic surface map, Fraunces display type, fluid display steps, a softer radius, warm shadows and motion tokens. Hex is the sRGB fallback; contrast is WCAG 2.1 computed from the OKLCH values.",
  "inherits": "../v2/tokens.json",
  "scales": {
    "sand": {
      "50": {
        "oklch": "oklch(0.985 0.007 80.0)",
        "hex": "#fdfaf5",
        "contrastOnWhite": 1.04
      },
      "100": {
        "oklch": "oklch(0.967 0.013 78.0)",
        "hex": "#f9f3eb",
        "contrastOnWhite": 1.1
      },
      "200": {
        "oklch": "oklch(0.93 0.021 76.0)",
        "hex": "#f0e6d9",
        "contrastOnWhite": 1.23
      },
      "300": {
        "oklch": "oklch(0.88 0.029 74.0)",
        "hex": "#e3d5c3",
        "contrastOnWhite": 1.44
      },
      "400": {
        "oklch": "oklch(0.8 0.037 72.0)",
        "hex": "#cdbaa4",
        "contrastOnWhite": 1.88
      },
      "500": {
        "oklch": "oklch(0.7 0.041 70.0)",
        "hex": "#af9a83",
        "contrastOnWhite": 2.69
      },
      "600": {
        "oklch": "oklch(0.6 0.039 68.0)",
        "hex": "#907c68",
        "contrastOnWhite": 3.97
      },
      "700": {
        "oklch": "oklch(0.5 0.033 66.0)",
        "hex": "#716050",
        "contrastOnWhite": 6.04
      },
      "800": {
        "oklch": "oklch(0.41 0.027 64.0)",
        "hex": "#55483b",
        "contrastOnWhite": 8.88
      },
      "900": {
        "oklch": "oklch(0.32 0.021 62.0)",
        "hex": "#3b3128",
        "contrastOnWhite": 12.74
      },
      "950": {
        "oklch": "oklch(0.235 0.015 60.0)",
        "hex": "#241d17",
        "contrastOnWhite": 16.71
      }
    }
  },
  "semantic": {
    "light": {
      "background": "sand-50",
      "foreground": "neutral-950",
      "card": "white",
      "muted": "sand-100",
      "muted-foreground": "neutral-700",
      "border": "sand-200",
      "input": "sand-300",
      "primary": "teal-700",
      "primary-foreground": "teal-50",
      "secondary": "coral-100",
      "secondary-foreground": "coral-800",
      "accent": "teal-50",
      "accent-foreground": "teal-800",
      "ring": "teal-500",
      "sidebar": "sand-100",
      "selection": "coral-200"
    },
    "dark": {
      "note": "unchanged from v2 (teal-tinted ink surfaces)"
    }
  },
  "contrastPairs": [
    {
      "fg": "neutral-950",
      "bg": "sand-50",
      "ratio": 15.93
    },
    {
      "fg": "neutral-700",
      "bg": "sand-50",
      "ratio": 6.36
    },
    {
      "fg": "neutral-700",
      "bg": "sand-100",
      "ratio": 6.04

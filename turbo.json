{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "15",
  "globalDependencies": ["pnpm-workspace.yaml"],
  "globalEnv": ["NODE_ENV", "VERCEL", "VERCEL_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "POSTGRES_URL",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_HOST",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "PGHOST",
    "PGHOST_UNPOOLED",
    "PGUSER",
    "PGPASSWORD",
    "PGDATABASE",
    "NEON_PROJECT_ID",
    "AUDIT_DATABASE_URL",
    "AUDIT_DATABASE_URL_UNPOOLED",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_NAME",
    "WORKOS_COOKIE_PASSWORD",
    "WORKOS_VAULT_NAMESPACE",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "ELEVA_COOKIE_DOMAIN",
    "ELEVA_TRUSTED_ORIGINS",
    "PASSKEY_RP_ID",
    "PASSKEY_ORIGIN",
    "ELEVA_KEK_V1",
    "ELEVA_KEK_V2",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "MICROSOFT_OAUTH_CLIENT_ID",
    "MICROSOFT_OAUTH_CLIENT_SECRET",
    "MS_OAUTH_CLIENT_ID",
    "MS_OAUTH_CLIENT_SECRET",
    "DAILY_API_KEY",
    "DAILY_DOMAIN",
    "DAILY_WEBHOOK_SECRET",
    "ELEVA_RLS_INTEGRATION",
    "SENTRY_DSN",
    "SENTRY_PROJECT",
    "BETTERSTACK_HEARTBEAT_URL",
    "BETTERSTACK_LOGS_SOURCE_TOKEN",
    "CRON_SECRET",
    "EDGE_CONFIG",
    "FLAGS_SECRET",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN",
    "KV_REST_API_READ_ONLY_TOKEN",
    "KV_URL",
    "REDIS_URL",
    "QSTASH_URL",
    "QSTASH_TOKEN",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",
    "WORKFLOWS_DRAIN_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_PRIVATE_READ_WRITE_TOKEN",
    "STRIPE_SECRET_KEY",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_CONNECT_CLIENT_ID",
    "STRIPE_API_VERSION",
    "STRIPE_BILLING_PORTAL_CONFIGURATION_ID",
    "WORKOS_SEAT_METER_ID",
    "ELEVA_API_BEARER_TOKEN",
    "API_BASE_URL",
    "NEXT_RUNTIME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "APP_URL",
        "ADMIN_URL",
        "ACCOUNT_URL",
        "API_URL",
        "DOCS_URL",
        "NEXT_PUBLIC_ACCOUNT_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "APP_ASSET_PREFIX",
        "API_ASSET_PREFIX",
        "EXPERT_ASSET_PREFIX",
        "TEAM_ASSET_PREFIX",
        "ACADEMY_ASSET_PREFIX",
        "ACCOUNT_ASSET_PREFIX",
        "DOCS_ASSET_PREFIX",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "../../vitest.shared.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "name": "@eleva/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "media:search": "node --env-file-if-exists=../../.env.local --import tsx/esm scripts/media.ts search",
    "media:import": "node --env-file-if-exists=../../.env.local --import tsx/esm scripts/media.ts import",
    "media:import-local": "node --env-file-if-exists=../../.env.local --import tsx/esm scripts/media.ts import-local"
  },
  "dependencies": {
    "@eleva/config": "workspace:*",
    "@eleva/ui": "workspace:*",
    "@mux/mux-video-react": "^0.31.5",
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@eleva/eslint-config": "workspace:*",
    "@eleva/storage": "workspace:*",
    "@eleva/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./image": "./src/eleva-image.tsx",
    "./video": "./src/eleva-video.tsx"
  }
}

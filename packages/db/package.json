{
  "name": "@eleva/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/main/index.ts",
    "./schema/audit": "./src/schema/audit/index.ts",
    "./context": "./src/context.ts",
    "./client": "./src/client.ts",
    "./rls": "./src/rls/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "tsx --env-file=../../.env.local node_modules/drizzle-kit/bin.cjs generate --config drizzle.config.ts",
    "db:generate:audit": "tsx --env-file=../../.env.local node_modules/drizzle-kit/bin.cjs generate --config drizzle.config.audit.ts",
    "db:push": "tsx --env-file=../../.env.local node_modules/drizzle-kit/bin.cjs push --config drizzle.config.ts",
    "db:push:audit": "tsx --env-file=../../.env.local node_modules/drizzle-kit/bin.cjs push --config drizzle.config.audit.ts",
    "db:studio": "tsx --env-file=../../.env.local node_modules/drizzle-kit/bin.cjs studio --config drizzle.config.ts",
    "db:rls": "tsx --env-file=../../.env.local -e \"import('./src/rls/apply-rls.ts').then(m => m.applyAllRls())\"",
    "db:fts": "tsx --env-file=../../.env.local src/migrations/run-fts.ts",
    "db:seed:demo": "tsx --env-file=../../.env.local src/seed/run-demo.ts",
    "db:seed:categories": "tsx --env-file=../../.env.local src/seed/run-categories.ts",
    "db:fix:stripe-state-machine": "tsx --env-file=../../.env.local scripts/fix-stripe-event-state-machine.ts",
    "db:backfill:org-slugs": "tsx --env-file=../../.env.local scripts/backfill-org-slugs.ts"
  },
  "dependencies": {
    "@eleva/config": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@eleva/eslint-config": "workspace:*",
    "@eleva/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "name": "elevacare-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "vitest",
    "rbac:generate": "pnpm --filter=@eleva/infra-workos rbac:generate",
    "flags:sync": "pnpm --filter=@eleva/flags flags:sync",
    "db:seed:demo": "pnpm --filter=@eleva/db db:seed:demo",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eleva/eslint-config": "workspace:*",
    "@eleva/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "only-allow": "^1.2.1",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.14",
    "typescript": "5.9.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.15.0"
  },
  "patchedDependencies": {
    "@workos-inc/widgets-i18n": "patches/@workos-inc__widgets-i18n.patch"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ]
}

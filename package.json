{
  "name": "elevacare-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "turbo build --filter=!@eleva/poc",
    "build:debug": "turbo build --summarize --filter=!@eleva/poc",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check:api-first-actions": "node scripts/check-api-first-actions.mjs",
    "check:route-guards": "node scripts/check-route-guards.mjs",
    "check:i18n-parity": "node --import tsx/esm scripts/check-i18n-parity.mjs",
    "e2e": "E2E_AUTH_BYPASS_TOKEN=\"${E2E_AUTH_BYPASS_TOKEN:-}\" playwright test",
    "e2e:auth": "E2E_AUTH=1 E2E_SKIP_WEBSERVER=1 playwright test e2e/auth-api.spec.ts e2e/auth.spec.ts e2e/admin.spec.ts --workers=1",
    "e2e:phase04": "E2E_SKIP_WEBSERVER=1 E2E_LIVE_STRIPE=1 playwright test e2e/booking.spec.ts e2e/phase-04.spec.ts --workers=1",
    "e2e:ui": "playwright test --ui",
    "test": "turbo test",
    "test:watch": "vitest",
    "turbo:login": "turbo login",
    "turbo:link": "turbo link",
    "turbo:unlink": "turbo unlink",
    "turbo:info": "turbo info",
    "commitlint": "commitlint --edit",
    "review": "coderabbit review --uncommitted --include-untracked",
    "review:branch": "coderabbit review --committed --base main",
    "review:agent": "coderabbit review --agent --base main",
    "docs:execution-plan:html": "node docs/eleva-v3/execution-plan/build-html.mjs",
    "stripe:seed": "pnpm stripe:seed:products --apply && pnpm stripe:seed:entitlements --apply",
    "stripe:seed:products": "pnpm --filter=@eleva/infra-stripe seed:products",
    "stripe:seed:entitlements": "pnpm --filter=@eleva/infra-stripe seed:entitlements",
    "stripe:setup:webhooks": "pnpm --filter=@eleva/infra-stripe setup:webhooks",
    "stripe:setup:portal": "pnpm --filter=@eleva/infra-stripe setup:portal",
    "stripe:setup:payment-methods": "pnpm --filter=@eleva/infra-stripe setup:payment-methods",
    "stripe:backfill:org-customers": "pnpm --filter=@eleva/infra-stripe backfill:org-customers",
    "stripe:replay:event": "pnpm --filter=@eleva/infra-stripe replay:event",
    "stripe:verify:entitlements": "pnpm --filter=@eleva/infra-stripe verify:entitlements",
    "qstash:list": "pnpm --filter=@eleva/infra-qstash run list",
    "qstash:setup": "pnpm --filter=@eleva/infra-qstash run setup:all",
    "qstash:setup:audit-drainer": "pnpm --filter=@eleva/infra-qstash run setup:audit-drainer",
    "qstash:setup:stripe-stuck": "pnpm --filter=@eleva/infra-qstash run setup:stripe-stuck",
    "qstash:setup:domain-events": "pnpm --filter=@eleva/infra-qstash run setup:domain-events",
    "flags:sync": "pnpm --filter=@eleva/flags flags:sync",
    "db:seed:demo": "pnpm --filter=@eleva/db db:seed:demo",
    "db:seed:categories": "pnpm --filter=@eleva/db db:seed:categories",
    "db:fix:stripe-state-machine": "pnpm --filter=@eleva/db db:fix:stripe-state-machine",
    "db:backfill:auth-identity": "pnpm --filter=@eleva/db db:backfill:auth-identity -- --verify"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eleva/auth": "workspace:*",
    "@eleva/eslint-config": "workspace:*",
    "@eleva/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "@types/node": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "^9.1.7",
    "tsx": "catalog:",
    "lint-staged": "^17.0.4",
    "marked": "^15.0.12",
    "only-allow": "^1.2.1",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.14",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ]
}
